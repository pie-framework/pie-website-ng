{
  "name": "@pie-website/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @pie-website/app dev",
    "build": "bun --filter @pie-website/app build",
    "preview": "bun --filter @pie-website/app preview",
    "check": "bun --filter @pie-website/app check",
    "check:watch": "bun --filter @pie-website/app check:watch",
    "verify:site": "bun test tests/site.test.ts",
    "audit:a11y": "bun scripts/audit-accessibility.ts",
    "sync:docs": "bun scripts/sync-docs.ts",
    "sync:examples": "bun scripts/sync-element-demos.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/bun": "latest",
    "axe-core": "^4.14.0",
    "sharp": "^0.35.5"
  }
}
