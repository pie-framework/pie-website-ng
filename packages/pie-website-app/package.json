		"@tailwindcss/vite": "^4.3.5",
		"daisyui": "^5.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "1.0.0-beta.6",
		"@pie-players/pie-default-tool-loaders": "1.0.0-beta.6",
		"@pie-players/pie-i18n-generated": "1.0.0-beta.6",
