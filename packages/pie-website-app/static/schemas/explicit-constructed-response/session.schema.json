  "$id": "https://cdn.jsdelivr.net/npm/@pie-element/explicit-constructed-response@12.1.1/dist/schemas/session.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifier of the session"
