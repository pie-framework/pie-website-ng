{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/@pie-element/match-list@8.0.6/dist/schemas/session.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifier of the session"
    },
    "element": {
      "type": "string",
      "description": "The element the session belongs to"
    },
    "value": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      },
      "description": "The answer placed in each response area: the answer's `id`, keyed by the prompt's `id`"
    },
    "shuffledValues": {
      "type": "object",
      "properties": {
        "prompts": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "answers": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "description": "Prompt and answer ids in the order they were shuffled for this learner, when choice order is not locked"
    }
  },
  "definitions": {}
}
