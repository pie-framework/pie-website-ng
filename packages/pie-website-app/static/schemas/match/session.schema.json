{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/@pie-element/match@13.0.6/dist/schemas/session.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifier of the session"
    },
    "element": {
      "type": "string",
      "description": "The element the session belongs to"
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "boolean"
        }
      },
      "description": "For each row id, which answer columns the learner selected"
    },
    "shuffledValues": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number"
        ]
      },
      "description": "Row ids in the order they were shuffled for this learner, when row order is not locked"
    }
  },
  "definitions": {}
}
