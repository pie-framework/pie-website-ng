{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/@pie-element/multiple-choice@14.0.6/dist/schemas/session.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifier of the session"
    },
    "element": {
      "type": "string",
      "description": "The element the session belongs to"
    },
    "value": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Values of the selected choices"
    },
    "shuffledValues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Choice values in the order they were shuffled for this learner, when choice order is not locked"
    }
  },
  "definitions": {}
}
